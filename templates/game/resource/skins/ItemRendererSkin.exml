<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ItemRendererSkin"
    states="up,down,disabled"
    minWidth="100" minHeight="50"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect width="100%" height="100%"
        fillColor="0x1a1a2e"
        fillColor.down="0x16213e"
        fillColor.disabled="0x16213e"/>
    <eui:Label id="labelDisplay" left="12" right="12" top="0" bottom="0"
        verticalAlign="middle"
        textColor="0xdfe6e9"
        textColor.disabled="0x636e72"
        text="{data}" size="14"/>
</eui:Skin>
