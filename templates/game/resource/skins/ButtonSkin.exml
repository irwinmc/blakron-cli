<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ButtonSkin"
    states="up,down,disabled"
    minWidth="100" minHeight="50"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect id="bg" width="100%" height="100%"
        fillColor="0x6c5ce7"
        fillColor.down="0x5a4bd1"
        fillColor.disabled="0x636e72"
        strokeColor="0x4a3db5"
        strokeColor.down="0x3d3494"
        strokeColor.disabled="0x4a5459"
        strokeWeight="1"/>
    <eui:Label id="labelDisplay" left="8" right="8" top="8" bottom="8"
        textAlign="center" verticalAlign="middle"
        textColor="0xffffff"
        textColor.disabled="0xb2bec3"
        size="16"/>
    <eui:Image id="iconDisplay" horizontalCenter="0" verticalCenter="0"/>
</eui:Skin>
