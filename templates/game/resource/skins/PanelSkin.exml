<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.PanelSkin" minWidth="450" minHeight="230"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect left="0" right="0" top="0" bottom="0"
        fillColor="0x16213e"
        strokeColor="0x0f3460"
        strokeWeight="1"/>
    <eui:Group id="moveArea" left="0" right="0" top="0" height="45">
        <eui:Rect left="0" right="0" top="0" bottom="0" fillColor="0x0f3460"/>
        <eui:Label id="titleDisplay" left="15" right="45" verticalCenter="0"
            verticalAlign="middle" textColor="0xffffff" size="14" bold="true"/>
    </eui:Group>
    <eui:Button id="closeButton" right="5" top="5" width="35" height="35" label="×"/>
</eui:Skin>
