<?xml version="1.0" encoding="utf-8"?>
<eui:Skin class="skins.ProgressBarSkin" minWidth="30" minHeight="18"
    xmlns:eui="http://ns.egret.com/eui">
    <eui:Rect width="100%" height="100%"
        fillColor="0x2d3436"
        strokeColor="0x636e72"
        strokeWeight="1"/>
    <eui:Rect id="thumb" width="100%" height="100%"
        fillColor="0x6c5ce7"/>
    <eui:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"
        textAlign="center" verticalAlign="middle"
        textColor="0xdfe6e9" size="12"/>
</eui:Skin>
